From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Thu, 3 Sep 2026 21:48:12 -0400
Subject: [PATCH] sys/syscall.h: generate numbers for the syscalls our shims
 dispatch

The wrappers in src/libc/ fall back to a raw syscall() when the libc they
run against has no matching symbol, which needs __NR_* to be defined at
build time. Kernel headers older than the syscall in question don't define
it, so building against e.g. the 3.10 UAPI headers shipped by a
CentOS 7-era sysroot fails with "'__NR_openat2' undeclared".

Add the syscalls behind those shims -- plus close_range() and execveat(),
which the glibc compat wrappers need -- to the generator's list and
regenerate. The emitted blocks static_assert() against the kernel header
whenever it does define the number, so this stays self-checking.
---
 src/include/override/sys/generate-syscall.py |   13 +
 src/include/override/sys/syscall.h           | 1024 +++++++++++++++++-
 2 files changed, 980 insertions(+), 57 deletions(-)

diff --git a/src/include/override/sys/generate-syscall.py b/src/include/override/sys/generate-syscall.py
index ba44c93..dcfffa0 100755
--- a/src/include/override/sys/generate-syscall.py
+++ b/src/include/override/sys/generate-syscall.py
@@ -6,12 +6,25 @@ import sys
 
 # We only generate numbers for a dozen or so syscalls
 SYSCALLS = [
+    'close_range',   # defined in glibc header since glibc-2.34
+    'epoll_pwait2',  # defined in glibc header since glibc-2.35
+    'execveat',      # defined in glibc header since glibc-2.34
     'fchmodat2',     # defined in glibc header since glibc-2.39
+    'fsconfig',
+    'fsmount',
+    'fsopen',
     'kexec_file_load',
+    'mount_setattr',
+    'move_mount',
+    'openat2',
+    'open_tree',
     'open_tree_attr',
+    'pidfd_open',    # defined in glibc header since glibc-2.36
+    'pidfd_send_signal',
     'quotactl_fd',   # defined in glibc header since glibc-2.35
     'removexattrat',
     'setxattrat',
+    'statx',         # defined in glibc header since glibc-2.28
 ]  # fmt: skip
 
 
